{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "pickleball-studio/dist",
  "rewrites": [
    { "source": "/api/portal/:portalPath*", "destination": "/api/live?portalPath=:portalPath*" }
  ]
}
